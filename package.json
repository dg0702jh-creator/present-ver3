import React, { useState, useEffect, useRef } from 'react';

export default function App() {
  const [activeTab, setActiveTab] = useState('home');
  const [timeLeft, setTimeLeft] = useState({ days: 0, hours: 0, minutes: 0 });
  const [month, setMonth] = useState(new Date().getMonth() + 1);
  const [isChristmas, setIsChristmas] = useState(false);
  const [showCapsule, setShowCapsule] = useState(true);

  const [cheerMessage, setCheerMessage] = useState('');
  const [dogImage, setDogImage] = useState('');
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    const timer = setInterval(() => {
      const now = new Date();
      setMonth(now.getMonth() + 1);
      
      if (now.getMonth() === 11 && now.getDate() === 25) {
        setIsChristmas(true);
      }

      const target = new Date(`\${now.getFullYear()}-12-25T00:00:00`);
      const diff = target - now;
      if (diff > 0) {
        setTimeLeft({
          days: Math.floor(diff / (1000 * 60 * 60 * 24)),
          hours: Math.floor((diff / (1000 * 60 * 60)) % 24),
          minutes: Math.floor((diff / 1000 / 60) % 60),
        });
      }
    }, 1000);
    return () => clearInterval(timer);
  }, []);

  const handleCardSelect = async (cardIndex) => {
    setLoading(true);
    try {
      const aiResponse = await fetch('/api/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ cardIndex })
      });
      const aiData = await aiResponse.json();
      const dogResponse = await fetch('https://dog.ceo/api/breeds/image/random');
      const dogData = await dogResponse.json();
      setCheerMessage(aiData.cheerMessage);
      setDogImage(dogData.message);
    } catch(e) {
      setCheerMessage("오늘도 널 완전 응원해! ✨");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-slate-50 flex flex-col items-center justify-center p-4">
      {isChristmas && showCapsule && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-6">
          <div className="bg-white rounded-full px-10 py-6 shadow-2xl animate-bounce border-4 border-pink-300 text-center">
            <h2 className="text-xl font-bold text-pink-600">"나랑 친구 그 이상의 관계로 만날래?"</h2>
            <button onClick={() => setShowCapsule(false)} className="mt-4 text-sm text-slate-400 underline">닫기</button>
          </div>
        </div>
      )}

      <div className="max-w-md w-full bg-white rounded-3xl shadow-2xl overflow-hidden border border-slate-100">
        <div className="flex bg-slate-100 p-2">
          <button onClick={() => setActiveTab('home')} className={`flex-1 py-2 rounded-xl text-sm font-bold \${activeTab === 'home' ? 'bg-white shadow' : ''}`}>🏠 홈</button>
          <button onClick={() => setActiveTab('game')} className={`flex-1 py-2 rounded-xl text-sm font-bold \${activeTab === 'game' ? 'bg-white shadow' : ''}`}>🎮 게임</button>
        </div>

        {activeTab === 'home' ? (
          <div className="p-6 text-center">
            <h1 className="text-xl font-bold mb-4">🎄 내 친구의 생일 카운트다운</h1>
            <div className="bg-indigo-50 py-4 px-2 rounded-2xl text-indigo-600 font-extrabold text-xl mb-6">
              {timeLeft.days}일 {timeLeft.hours}시간 {timeLeft.minutes}분 남았어! 🎁
            </div>
            
            <p className="text-sm text-slate-500 mb-4">오늘의 응원 카드를 골라봐! 👇</p>
            <div className="grid grid-cols-3 gap-2 mb-6">
              {['🧸 다정', '🔥 열정', '😂 유머'].map((t, i) => (
                <button key={i} onClick={() => handleCardSelect(i)} className="bg-slate-50 p-2 rounded-xl text-xs font-bold border border-slate-100 hover:bg-indigo-50">{t} 카드</button>
              ))}
            </div>

            {loading && <p className="animate-pulse text-indigo-500">AI가 준비중...</p>}
            {cheerMessage && (
              <div className="space-y-4">
                <div className="bg-slate-50 p-4 rounded-xl border italic text-slate-700">"{cheerMessage}"</div>
                {dogImage && <img src={dogImage} className="w-full h-40 object-cover rounded-xl" />}
              </div>
            )}
          </div>
        ) : (
          <MiniGame month={month} />
        )}
      </div>
    </div>
  );
}

function MiniGame({ month }) {
  const [hp, setHp] = useState(100);
  const [score, setScore] = useState(0);
  const [gameOver, setGameOver] = useState(false);
  const [charPos, setCharPos] = useState(50);
  const [entities, setEntities] = useState([]);
  const [giftsCount, setGiftsCount] = useState(0);
  const [showProb, setShowProb] = useState(false);
  const [giftResult, setGiftResult] = useState(null);
  
  const startTime = useRef(Date.now());
  const lastGiftTime = useRef(0);

  let theme = { name: "여름 서핑", enemy: "🦈", bg: "bg-cyan-100", player: "🏄", giftSender: "🐬🎁" };
  if (month >= 9 && month <= 10) theme = { name: "가을 낙엽", enemy: "🍂", bg: "bg-orange-100", player: "🏃", giftSender: "🐿️🎁" };
  if (month >= 11 || month <= 2) theme = { name: "겨울 눈", enemy: "❄️", bg: "bg-blue-50", player: "🚶", giftSender: "🎅🎁" };

  useEffect(() => {
    if (gameOver) return;
    const interval = setInterval(() => {
      setScore(s => s + 1);
      
      if (Math.random() > 0.8) {
        setEntities(prev => [...prev, { id: Date.now() + Math.random(), x: Math.random() * 90, y: -10, type: 'enemy' }]);
      }

      const elapsed = Date.now() - startTime.current;
      // 30초(30,000ms) 이후부터 30초 간격으로 선물 드롭
      if (elapsed > 30000) {
        if (Date.now() - lastGiftTime.current > 30000) {
          setEntities(prev => [...prev, { id: 'gift-' + Date.now(), x: Math.random() * 90, y: -10, type: 'gift' }]);
          lastGiftTime.current = Date.now();
        }
      }

      setEntities(prev => {
        const next = prev.map(e => ({ ...e, y: e.y + 5 })).filter(e => e.y < 110);
        next.forEach(e => {
          if (e.y > 80 && e.y < 95 && Math.abs(e.x - charPos) < 10) {
            if (e.type === 'enemy') {
              setHp(h => {
                const newHp = h - 20;
                if (newHp <= 0) setGameOver(true);
                return newHp;
              });
              setScore(s => Math.max(0, s - 20));
              e.y = 200;
            } else if (e.type === 'gift') {
              setGiftsCount(g => g + 1);
              e.y = 200;
            }
          }
        });
        return next;
      });
    }, 100);
    return () => clearInterval(interval);
  }, [charPos, gameOver, month]);

  const openGift = () => {
    const rand = Math.random() * 100;
    if (rand < 0.5) setGiftResult("🎁 초대박: 주인장이 밥 사줌!");
    else if (rand < 1.5) setGiftResult("🎁 당첨: 5천원 이내 원하는 것!");
    else if (rand < 6.5) setGiftResult("🎁 소소: 간식 (1~2개)!");
    else setGiftResult("💀 꽝! 다음 기회에...");
  };

  return (
    <div className={`p-4 \${theme.bg} h-[500px] relative overflow-hidden flex flex-col`}>
      <div className="flex justify-between font-bold text-sm z-10">
        <div className="text-red-500">HP: {hp}</div>
        <div>Score: {score}</div>
        <div className="text-blue-600">선물: {giftsCount}</div>
      </div>

      <div className="flex-1 relative mt-4 border-2 border-white/50 rounded-xl overflow-hidden cursor-crosshair" 
           onMouseMove={(e) => {
             const rect = e.currentTarget.getBoundingClientRect();
             setCharPos(((e.clientX - rect.left) / rect.width) * 100);
           }}>
        {entities.map(e => (
          <div key={e.id} className="absolute text-2xl transition-all duration-100" style={{ left: `\${e.x}%`, top: `\${e.y}%` }}>
            {e.type === 'enemy' ? theme.enemy : theme.giftSender}
          </div>
        ))}

        <div className="absolute bottom-4 text-4xl transition-all duration-75" style={{ left: `\${charPos}%`, transform: 'translateX(-50%)' }}>
          {theme.player}
        </div>

        {gameOver && (
          <div className="absolute inset-0 bg-black/70 flex flex-col items-center justify-center text-white p-6 text-center z-30">
            <h2 className="text-3xl font-bold mb-2">GAME OVER</h2>
            <p className="mb-4">최종 점수: {score}</p>
            {giftsCount > 0 && !giftResult && (
              <button onClick={openGift} className="bg-yellow-400 text-black px-6 py-2 rounded-full font-bold mb-2">🎁 선물 상자 열기 (\${giftsCount}개)</button>
            )}
            {giftResult && <p className="text-yellow-300 font-bold text-lg mb-4">{giftResult}</p>}
            <button onClick={() => window.location.reload()} className="text-sm underline">다시 시작</button>
          </div>
        )}
      </div>

      <div className="mt-4 flex justify-between items-center">
        <p className="text-[10px] text-slate-500">\${theme.name} 게임 중...</p>
        <button onClick={() => setShowProb(!showProb)} className="bg-white/50 px-3 py-1 rounded-lg text-xs font-bold shadow-sm z-20">확률표 ℹ️</button>
      </div>

      {showProb && (
        <div className="absolute bottom-16 right-4 bg-white p-4 rounded-2xl shadow-xl text-xs border border-slate-200 z-40">
          <h3 className="font-bold mb-2">🎁 선물 확률표</h3>
          <ul className="space-y-1 text-slate-700">
            <li>• 0.5% : 주인장이 밥 사줌</li>
            <li>• 1.0% : 5천원 이내 원하는 것</li>
            <li>• 5.0% : 간식(1~2개)</li>
            <li>• 93.5% : 꽝</li>
          </ul>
        </div>
      )}
    </div>
  );
}
